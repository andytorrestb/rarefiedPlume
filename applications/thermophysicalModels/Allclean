#!/bin/bash
# Remove the hybrid plume thermo library's objects and the installed library.
set -euo pipefail
cd "${0%/*}" || exit 1
command -v wclean >/dev/null 2>&1 || { echo "Allclean: source OpenFOAM first" >&2; exit 1; }
wclean libso hybridPlumeThermo
rm -f "${FOAM_USER_LIBBIN:?}/libhybridPlumeThermo.so"
