#!/bin/bash
#
# Mesh every generated case of the Knudsen extension.
#
#   ./AllmeshCases                 mesh all of them
#   ./AllmeshCases --dict-only     write dictionaries only (no OpenFOAM needed)
#   ./AllmeshCases --keep-going    do not stop at the first failure
#   ./AllmeshCases --help
#
# SELECTING CASES -- for a job array
#
#   ./AllmeshCases --list              the case list, numbered, one per line
#   ./AllmeshCases --index 0           only case 0 (0-based, as --list prints it)
#   ./AllmeshCases --case Kn1_np1x     only this case, by name or by path
#
# --index is what an array task uses. With the four cases:
#
#   #SBATCH --array=0-3
#   ./AllmeshCases --index "$SLURM_ARRAY_TASK_ID"
#
# The order is manifest.yaml's, which generate_cases.py fixed: decreasing
# Knudsen number, and within each case increasing particle multiplier. It does
# not depend on directory iteration order, so index N means the same case on
# every node and in every rerun.
#
# EVERY case is meshed, including those marked unsuitable for production: a
# mesh is cheap next to a run, and the dense meshes are where the resolution
# deficit is reported from. Nothing gates on the verdict: every case is run, and
# its runCase.sh marks an unsuitable one NON-PRODUCTION.
#
# The case list goes through plumetools.cai2012ext.policy, which REFUSES the
# whole manifest if it names Kn = 0.01, 0.1 or 100 -- Cai's own cases, which this
# extension never meshes or runs. This is cases/cai2012/AllmeshCases otherwise.
#
# Each case meshes itself from its own case.yaml. Nothing here writes into a
# case; it only invokes ./Allmesh in each.

set -uo pipefail
SELF=${0##*/}
cd "$(dirname "$0")" || exit 1   # dirname, not ${0%/*}: works for "./x" and for "bash x"

ARGS=()
SELECT=()
LIST=0
KEEP_GOING=0
while [ $# -gt 0 ]; do
    case "$1" in
        --keep-going) KEEP_GOING=1 ;;
        --dict-only)  ARGS+=("--dict-only") ;;
        --list)        LIST=1 ;;
        --index)       shift; SELECT+=("${1:?"--index needs a case number"}") ;;
        --case)        shift; SELECT+=("${1:?"--case needs a case name"}") ;;
        -h|--help)    awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; exit 0 ;;
        *)            echo "AllmeshCases: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
done

die() { echo "" >&2; echo "AllmeshCases: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

[ -f manifest.yaml ] || die "no manifest.yaml. Generate the cases first:
       ./generate_cases.py"

have python && PYTHON=python || { have python3 && PYTHON=python3 || die "no python on PATH"; }

# Read the case paths from the manifest rather than globbing: the manifest is the
# record of what was generated, and a stale directory from an earlier study must
# not be picked up as if it belonged to this one. Through the policy gate, and
# captured BEFORE mapfile: a failure inside `< <(...)` would not reach a `||`.
LISTING=$($PYTHON -m plumetools.cai2012ext.policy manifest.yaml --all) \
    || die "manifest.yaml breaks the extension policy (above); nothing meshed"
[ -n "$LISTING" ] || die "manifest.yaml lists no cases"
mapfile -t CASES <<< "$LISTING"

# --------------------------------------------------------------------------- #
# case selection
# --------------------------------------------------------------------------- #
#
# The manifest order is the contract -- see --help. Selecting by index rather
# than by globbing is what lets a job array address one case per task without
# every task having to agree about how a shell sorts names.

if [ "$LIST" -eq 1 ]; then
    for i in "${!CASES[@]}"; do
        printf '%d\t%s\n' "$i" "${CASES[$i]}"
    done
    exit 0
fi

if [ ${#SELECT[@]} -gt 0 ]; then
    PICKED=()
    for want in "${SELECT[@]}"; do
        FOUND=""
        case "$want" in
            ''|*[!0-9]*)
                # A name or a path.
                for case_path in "${CASES[@]}"; do
                    if [ "$case_path" = "$want" ] || [ "${case_path##*/}" = "$want" ]; then
                        FOUND=$case_path
                        break
                    fi
                done
                [ -n "$FOUND" ] || die "no case '$want' in manifest.yaml.
       Use --list to see the ${#CASES[@]} case(s) it holds." ;;
            *)
                # An index, 0-based.
                [ "$want" -lt ${#CASES[@]} ] || die "--index $want is past the
       end: manifest.yaml holds ${#CASES[@]} case(s), so the valid range is
       0-$(( ${#CASES[@]} - 1 )). Use --list to see them."
                FOUND=${CASES[$want]} ;;
        esac
        PICKED+=("$FOUND")
    done
    CASES=("${PICKED[@]}")
fi

echo "### meshing ${#CASES[@]} case(s)"
echo ""

FAILED=()
for case_path in "${CASES[@]}"; do
    echo "=============================================================="
    echo "### $case_path"
    echo "=============================================================="
    if [ -x "$case_path/Allmesh" ]; then
        "$case_path/Allmesh" "${ARGS[@]+"${ARGS[@]}"}" || FAILED+=("$case_path")
    elif [ -f "$case_path/Allmesh" ]; then
        bash "$case_path/Allmesh" "${ARGS[@]+"${ARGS[@]}"}" || FAILED+=("$case_path")
    else
        echo "AllmeshCases: $case_path has no Allmesh" >&2
        FAILED+=("$case_path")
    fi

    if [ ${#FAILED[@]} -gt 0 ] && [ "$KEEP_GOING" -eq 0 ]; then
        die "${FAILED[0]} failed. Its log files are in that directory.
       Use --keep-going to mesh the remaining cases anyway."
    fi
    echo ""
done

if [ ${#FAILED[@]} -gt 0 ]; then
    echo "" >&2
    echo "AllmeshCases: ${#FAILED[@]} of ${#CASES[@]} case(s) failed:" >&2
    printf '    %s\n' "${FAILED[@]}" >&2
    exit 1
fi

echo "### all ${#CASES[@]} case(s) meshed"
echo "    next:  cd Cases/<case> && qsub runCase.sh   (one PBS job per case)"
