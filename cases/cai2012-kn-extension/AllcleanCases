#!/bin/bash
#
# Clean every generated case.
#
#   ./AllcleanCases              remove solver output from each case
#   ./AllcleanCases --dry-run    list what would be removed
#   ./AllcleanCases --mesh       also remove each case's mesh and dictionaries
#   ./AllcleanCases --purge      DELETE the active cases tree and its manifest
#   ./AllcleanCases --help
#
# Delegates to each case's own ./Allclean, which refuses to run in a directory
# without a case.yaml. Active paths come from study.yaml; shared results and
# historical cases trees are retained.
#
# NEVER touched:
#   baseCase/          the template
#   study.yaml         the case matrix
#   generate_cases.py, AllmeshCases, AllrunCases, AllpostCases, this script
#   any other case family under cases/

set -uo pipefail
SELF=${0##*/}
cd "$(dirname "$0")" || exit 1   # dirname, not ${0%/*}: works for "./x" and for "bash x"

DRY=0
PURGE=0
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)  DRY=1; ARGS+=("--dry-run") ;;
        --mesh)     ARGS+=("--mesh") ;;
        --purge)    PURGE=1 ;;
        -h|--help)  awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; exit 0 ;;
        *)          echo "AllcleanCases: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
done

die() { echo "" >&2; echo "AllcleanCases: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
have python && PYTHON=python || { have python3 && PYTHON=python3 || die "no python on PATH"; }

if [ "$PURGE" -eq 1 ]; then
    $PYTHON - "$DRY" <<'PY'
import shutil
import sys
from pathlib import Path
from plumetools.cai2012.study import load_study
from plumetools.cai2012ext import policy
root = Path.cwd().resolve()
study = load_study(root / "study.yaml")
policy.check_study(study)
paths = [root / study.cases_dir, root / study.manifest_name]
if any(path.is_symlink() for path in paths):
    raise ValueError("Refusing to purge a symlinked cases tree or manifest")
targets = [path.resolve() for path in paths]
for target in targets:
    if target == root or not target.is_relative_to(root):
        raise ValueError(f"Refusing cleanup outside the active study: {target}")
print("Purge active generated cases and manifest only; shared/legacy results are retained:")
for target in targets:
    print(f"    {target}")
if int(sys.argv[1]):
    print("--dry-run: nothing removed.")
else:
    for target in targets:
        if target.is_dir():
            shutil.rmtree(target)
        elif target.exists():
            target.unlink()
PY
    exit $?
fi

LISTING=$($PYTHON -m plumetools.cai2012ext.policy --study study.yaml --all) \
    || die "the active study manifest is missing or invalid; nothing cleaned"
mapfile -t CASES <<< "$LISTING"

echo "### cleaning ${#CASES[@]} case(s)"
echo ""

for case_path in "${CASES[@]}"; do
    if [ ! -d "$case_path" ]; then
        echo "    $case_path is already gone"
        continue
    fi
    if [ -x "$case_path/Allclean" ]; then
        "$case_path/Allclean" "${ARGS[@]+"${ARGS[@]}"}"
    elif [ -f "$case_path/Allclean" ]; then
        bash "$case_path/Allclean" "${ARGS[@]+"${ARGS[@]}"}"
    else
        echo "    $case_path has no Allclean; skipped" >&2
    fi
done

echo ""
if [ "$DRY" -eq 1 ]; then
    echo "--dry-run: nothing removed."
else
    echo "### done"
fi
