#!/bin/bash
#
# Run the Knudsen extension's production candidates, in manifest order.
#
#   ./AllrunCases                      every case marked production-candidate
#   ./AllrunCases --dry-run            what would run and what is refused; no solver
#   ./AllrunCases --serial             one process per case
#   ./AllrunCases -np 64               override the subdomain count (HPC)
#   ./AllrunCases --keep-going         do not stop at the first failure
#   ./AllrunCases --keep-clouds        do not prune reconstructed parcel clouds
#   ./AllrunCases --prune-transient    after a case reaches endTime, delete its
#                                      time directories BEFORE the averaging
#                                      start (they hold no *Mean field)
#   ./AllrunCases --allow-unsuitable   ALSO run cases marked unsuitable for
#                                      production; each gets a NON-PRODUCTION
#                                      marker and its outputs are labelled
#   ./AllrunCases --help
#
# SELECTING CASES -- for a job array
#
#   ./AllrunCases --list               the runnable cases, numbered
#   ./AllrunCases --index 0            only runnable case 0 (as --list prints it)
#   ./AllrunCases --case Kn1_np1x      only this case, by name or by path
#
# The numbering is of the RUNNABLE list, so pass the same --allow-unsuitable to
# --list and to --index, or index N names a different case. With the two
# production candidates (Kn10_np1x, Kn1_np1x):
#
#   #SBATCH --array=0-1
#   ./AllrunCases --index "$SLURM_ARRAY_TASK_ID" -np "$SLURM_NTASKS"
#
# THE GATE. generate_cases.py assessed every case against the production
# criteria (plumetools/cai2012ext/feasibility.py) and wrote the verdict into
# manifest.yaml. A case marked unsuitable-for-production is listed with its
# unresolved criteria and NOT run. The policy gate also refuses the whole
# manifest if it names Kn = 0.01, 0.1 or 100: Cai's own cases are never run here.
#
# From cases/cai2012/AllrunCases: the selection above, sequential runs (each
# case uses every core it is given), and continuing an interrupted case from its
# newest time directory -- see ./Allrun --help.
#
# From cases/cai2012-health/AllrunCases: a case that has already reached
# endTime is skipped without invoking it; each case is timed and its wall clock
# recorded in results/cost-model.yaml, which ./generate_cases.py then prefers to
# the health family's collisionless measurements; reconstructed parcel clouds
# are pruned from every time but the newest (nothing here reads parcel
# positions; processor*/ is untouched, so a resume still works).

set -uo pipefail
SELF=${0##*/}
cd "$(dirname "$0")" || exit 1   # dirname, not ${0%/*}: works for "./x" and for "bash x"

ARGS=()
SELECT=()
LIST=0
DRY=0
KEEP_GOING=0
KEEP_CLOUDS=0
PRUNE_TRANSIENT=0
ALLOW_UNSUITABLE=0
while [ $# -gt 0 ]; do
    case "$1" in
        --keep-going)       KEEP_GOING=1 ;;
        --keep-clouds)      KEEP_CLOUDS=1 ;;
        --prune-transient)  PRUNE_TRANSIENT=1 ;;
        --allow-unsuitable) ALLOW_UNSUITABLE=1 ;;
        --dry-run)          DRY=1 ;;
        -s|--serial)        ARGS+=("--serial") ;;
        -np)                shift; ARGS+=("-np" "${1:?"-np needs a subdomain count"}") ;;
        --no-solve)         ARGS+=("--no-solve") ;;
        --list)             LIST=1 ;;
        --index)            shift; SELECT+=("${1:?"--index needs a case number"}") ;;
        --case)             shift; SELECT+=("${1:?"--case needs a case name"}") ;;
        -h|--help)          awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; exit 0 ;;
        *)                  echo "AllrunCases: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
done

die() { echo "" >&2; echo "AllrunCases: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

[ -f manifest.yaml ] || die "no manifest.yaml. Generate the cases first:
       ./generate_cases.py"

have python && PYTHON=python || { have python3 && PYTHON=python3 || die "no python on PATH"; }

# --------------------------------------------------------------------------- #
# the gate: excluded Kn refuse everything; unsuitable cases are listed, not run
# --------------------------------------------------------------------------- #
GATE_ARGS=()
[ "$ALLOW_UNSUITABLE" -eq 1 ] && GATE_ARGS+=("--allow-unsuitable")
LISTING=$($PYTHON -m plumetools.cai2012ext.policy manifest.yaml "${GATE_ARGS[@]+"${GATE_ARGS[@]}"}") \
    || die "manifest.yaml breaks the extension policy (above); nothing run"
[ -n "$LISTING" ] || die "no case is runnable: every case in manifest.yaml is
       marked unsuitable for production (listed above). Resolve the criteria in
       study.yaml / baseCase and regenerate, or pass --allow-unsuitable to run
       them as NON-PRODUCTION."
mapfile -t CASES <<< "$LISTING"

# --------------------------------------------------------------------------- #
# case selection -- as cases/cai2012/AllrunCases, over the runnable list
# --------------------------------------------------------------------------- #

if [ "$LIST" -eq 1 ]; then
    for i in "${!CASES[@]}"; do
        printf '%d\t%s\n' "$i" "${CASES[$i]}"
    done
    exit 0
fi

if [ ${#SELECT[@]} -gt 0 ]; then
    PICKED=()
    for want in "${SELECT[@]}"; do
        FOUND=""
        case "$want" in
            ''|*[!0-9]*)
                for case_path in "${CASES[@]}"; do
                    if [ "$case_path" = "$want" ] || [ "${case_path##*/}" = "$want" ]; then
                        FOUND=$case_path
                        break
                    fi
                done
                [ -n "$FOUND" ] || die "no runnable case '$want'. Use --list to see
       the ${#CASES[@]} runnable case(s); a case marked unsuitable for production
       needs --allow-unsuitable." ;;
            *)
                [ "$want" -lt ${#CASES[@]} ] || die "--index $want is past the
       end: ${#CASES[@]} runnable case(s), so the valid range is
       0-$(( ${#CASES[@]} - 1 )). Use --list (with the same flags) to see them."
                FOUND=${CASES[$want]} ;;
        esac
        PICKED+=("$FOUND")
    done
    CASES=("${PICKED[@]}")
fi

case_reached_end() {
    "$PYTHON" - "$1" <<'PY'
import re
import sys
from pathlib import Path

case = Path(sys.argv[1])
control = case / "system" / "controlDict"
entries = {}
for line in control.read_text(encoding="utf-8").splitlines():
    match = re.match(r"\s*(endTime|deltaT)\s+([^;]+);", line)
    if match:
        entries[match.group(1)] = float(match.group(2))

times = []
for parent in (case, *case.glob("processor[0-9]*")):
    if not parent.is_dir():
        continue
    for entry in parent.iterdir():
        if entry.is_dir():
            try:
                value = float(entry.name)
            except ValueError:
                continue
            if value > 0.0:
                times.append(value)

latest = max(times, default=None)
end = entries.get("endTime")
delta = entries.get("deltaT", 0.0)
sys.exit(0 if latest is not None and end is not None
         and latest >= end - 0.5 * delta else 1)
PY
}

echo "### ${#CASES[@]} case(s) to run, sequentially, in manifest order"
$PYTHON - <<'PY'
from pathlib import Path
from plumetools.cai2012ext.feasibility import load_cost_model
model, origin = load_cost_model(Path("."), Path("../cai2012-health"))
print(f"    cost model  {model.source}")
print(f"                ({origin})")
PY
echo ""

if [ "$DRY" -eq 1 ]; then
    for case_path in "${CASES[@]}"; do
        echo "    would run  $case_path"
    done
    echo ""
    echo "--dry-run: nothing run."
    exit 0
fi

START=$(date +%s)
FAILED=()
for case_path in "${CASES[@]}"; do
    echo "=============================================================="
    echo "### $case_path"
    echo "=============================================================="
    [ -d "$case_path/constant/polyMesh" ] || die "$case_path has no mesh.
       Run ./AllmeshCases first."

    if [ "$ALLOW_UNSUITABLE" -eq 1 ]; then
        # The verdict travels with the case, so nothing post-processed from it
        # can be mistaken for a production result.
        $PYTHON - "$case_path" <<'PY' || die "could not mark $case_path"
import sys
from pathlib import Path

import yaml

case_path = sys.argv[1]
manifest = yaml.safe_load(Path("manifest.yaml").read_text(encoding="utf-8"))
entry = next(e for e in manifest["cases"] if e["path"] == case_path)
feasibility = entry.get("feasibility") or {}
if feasibility.get("status") != "production-candidate":
    marker = Path(case_path) / "NON-PRODUCTION"
    marker.write_text(
        "This case was run with ./AllrunCases --allow-unsuitable.\n"
        "It is UNSUITABLE FOR PRODUCTION; nothing from it is a validated "
        "result.\n\nUnresolved:\n"
        + "".join(f"  - {line}\n" for line in feasibility.get("unresolved", [])),
        encoding="utf-8")
    print(f"    marked NON-PRODUCTION: {marker}")
PY
    fi

    if case_reached_end "$case_path"; then
        echo "### $case_path has already reached endTime; skipping"
        echo ""
        continue
    fi

    CASE_START=$(date +%s)
    if [ -x "$case_path/Allrun" ]; then
        "$case_path/Allrun" "${ARGS[@]+"${ARGS[@]}"}" || FAILED+=("$case_path")
    elif [ -f "$case_path/Allrun" ]; then
        bash "$case_path/Allrun" "${ARGS[@]+"${ARGS[@]}"}" || FAILED+=("$case_path")
    else
        echo "AllrunCases: $case_path has no Allrun" >&2
        FAILED+=("$case_path")
    fi
    ELAPSED=$(( $(date +%s) - CASE_START ))
    echo "    elapsed ${ELAPSED} s"

    if [ ${#FAILED[@]} -eq 0 ] || [ "$KEEP_GOING" -eq 1 ]; then
        $PYTHON - "$case_path" "$ELAPSED" "$KEEP_CLOUDS" "$PRUNE_TRANSIENT" <<'PY'
import shutil
import sys
from pathlib import Path

import yaml

from plumetools.cai2012ext.feasibility import load_cost_model, record_measurement

case_path = Path(sys.argv[1])
elapsed = float(sys.argv[2])
keep_clouds = sys.argv[3] == "1"
prune_transient = sys.argv[4] == "1"

manifest = yaml.safe_load(Path("manifest.yaml").read_text(encoding="utf-8"))
row = next((c for c in manifest.get("cases", [])
            if c["path"] == str(case_path).replace("\\", "/")), None)


def time_dirs(parent: Path):
    """(time, dir) for every numeric directory, ascending. float() is the only
    honest test: OpenFOAM writes 0.0021211 and 9.9177e-03 alike."""
    found = []
    for entry in parent.iterdir() if parent.is_dir() else ():
        if entry.is_dir():
            try:
                found.append((float(entry.name), entry))
            except ValueError:
                pass
    return sorted(found, key=lambda item: item[0])


def size(path: Path) -> int:
    return sum(f.stat().st_size for f in path.rglob("*") if f.is_file())


# --- prune reconstructed parcel clouds (cases/cai2012-health) ------------- #
if not keep_clouds:
    times = time_dirs(case_path)
    freed = 0
    for _, directory in times[:-1]:
        cloud = directory / "lagrangian"
        if cloud.is_dir():
            freed += size(cloud)
            shutil.rmtree(cloud)
    if freed:
        print(f"    pruned {freed / 1024 ** 3:.1f} GB of reconstructed parcel "
              f"clouds ({len(times) - 1} time(s); the newest is kept)")

# --- prune the transient, only if asked and only once finished ------------ #
if prune_transient and row is not None:
    start = float(row["average_start_s"])
    end = float(row["end_time_s"])
    dt = float(row["deltaT_s"])
    parents = [case_path, *sorted(case_path.glob("processor[0-9]*"))]
    latest = max((t for p in parents for t, _ in time_dirs(p)), default=0.0)
    if latest >= end - 0.5 * dt:
        freed = 0
        for parent in parents:
            for value, directory in time_dirs(parent):
                # Strictly before the averaging start, and never time 0.
                if 0.0 < value < start * (1.0 - 1.0e-9):
                    freed += size(directory)
                    shutil.rmtree(directory)
        print(f"    pruned the transient: {freed / 1024 ** 3:.1f} GB of time "
              f"directories before t = {start:.6g} s (no *Mean field in them)")
    else:
        print("    --prune-transient: the case has not reached endTime; "
              "nothing pruned")

# --- record the wall clock -------------------------------------------------- #
if row is None:
    print(f"    not timed: {case_path} is not in the manifest")
    raise SystemExit(0)
record_measurement(Path("results") / "cost-model.yaml", {
    "case": row["name"],
    "path": row["path"],
    "Kn": float(row["Kn"]),
    "seconds": elapsed,
    "parcels": float(row.get("estimated_particles", 0.0)),
    "cells": int(row.get("n_cells", 0)),
    "steps": int(row.get("n_steps", 0)),
    "numerical_particle_multiplier": float(row["numerical_particle_multiplier"]),
    "production_status": row.get("production_status"),
})
model, _ = load_cost_model(Path("."), Path("../cai2012-health"))
predicted = (row.get("feasibility") or {}).get("cost", {}).get(
    "predicted_wall_hours")
if predicted:
    print(f"    predicted >= {float(predicted):.2f} h, took "
          f"{elapsed / 3600:.2f} h")
print(f"    cost model now: {model.source}")
PY
    fi

    if [ ${#FAILED[@]} -gt 0 ] && [ "$KEEP_GOING" -eq 0 ]; then
        die "${FAILED[0]} failed. Its log files are in that directory.
       Use --keep-going to run the remaining cases anyway."
    fi
    echo ""
done

echo "### finished in $(( $(date +%s) - START )) s"
if [ ${#FAILED[@]} -gt 0 ]; then
    echo "" >&2
    echo "AllrunCases: ${#FAILED[@]} of ${#CASES[@]} case(s) failed:" >&2
    printf '    %s\n' "${FAILED[@]}" >&2
    exit 1
fi
echo "    next:  ./AllpostCases"
