#!/bin/bash
#
# Generate this case's mesh and OpenFOAM dictionaries from case.yaml.
#
#   ./Allmesh                 generate dictionaries, mesh, check, verify
#   ./Allmesh --dict-only     write the dictionaries and stop (no OpenFOAM needed)
#   ./Allmesh --help
#
# Pipeline:
#
#   plumetools     -> system/blockMeshDict, snappyHexMeshDict, meshQualityDict
#                     constant/dsmcProperties, system/controlDict,
#                     dsmcInitialiseDict, decomposeParDict, fvSchemes, fvSolution
#   blockMesh      -> the uniform Cartesian background box
#   snappyHexMesh  -> carve the inflow hemisphere, the cylinder and the plate
#   checkMesh      -> mesh quality
#   verify         -> that the mesh IS the geometry case.yaml declares
#
# case.yaml is the authoritative source for every physical input. The generated
# dictionaries are overwritten each time and are gitignored; do not edit them.
#
# Unlike the 3d-inflow case, running this destroys nothing irreplaceable: the
# mesh here is generated, not a Pointwise export, so it is safe to re-run.

set -uo pipefail
SELF=${0##*/}
cd "${0%/*}" || exit 1

DICT_ONLY=0
case "${1:-}" in
    "")           ;;
    --dict-only)  DICT_ONLY=1 ;;
    -h|--help)    awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; exit 0 ;;
    *)            echo "Allmesh: unknown option '$1' (try --help)" >&2; exit 2 ;;
esac

die() { echo "" >&2; echo "Allmesh: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Run a command, log it, and surface the FOAM error rather than the tail: under
# mpirun the last lines are MPI teardown from every rank and the real cause has
# scrolled past.
run() {
    local log="log.$1"; shift
    echo "==> $* (-> $log)"
    if ! "$@" > "$log" 2>&1; then
        echo "" >&2
        if grep -q "FOAM FATAL" "$log"; then
            sed "s/^\[[0-9]*\] //" "$log" \
                | awk "/FOAM FATAL/{f=1} f{print} f&&/^\s*\$/{n++; if(n>=3) exit}" \
                | head -20 >&2
        else
            tail -25 "$log" >&2
        fi
        die "'$1' failed; full output in $PWD/$log"
    fi
}

have python && PYTHON=python || { have python3 && PYTHON=python3 || die "no python on PATH"; }
$PYTHON -c "import plumetools" 2>/dev/null \
    || die "plumetools is not importable. From the repository root:
       pip install -e \".[test]\""

# --------------------------------------------------------------------------- #
# 1. dictionaries
# --------------------------------------------------------------------------- #

echo "==> generating dictionaries from case.yaml"
$PYTHON - <<'PY' || die "dictionary generation failed"
from pathlib import Path

from plumetools.config import load_case_config
from plumetools.markelov1999 import foamdicts, mesh, resolution
from plumetools.markelov1999.geometry import from_config

cfg = load_case_config(".")
geom = from_config(cfg)

print()
print("\n".join(geom.describe()))
print()
print("\n".join(mesh.describe(cfg)))
print()

for path in mesh.write_mesh_setup(".", cfg):
    print(f"    wrote {path}")

# The particle weight is resolved HERE, not left implicit: generate_cases.py
# normally writes it into case.yaml, but a case meshed straight from baseCase
# has it as null and dsmcProperties needs a number.
cell_sizes = mesh.surface_cell_sizes(cfg)
estimate = resolution.estimate(cfg, geom, cell_sizes,
                               n_equivalent_particles=cfg.dsmc.n_equivalent_particles)
print()
print("\n".join(estimate.report()))
print()

for path in foamdicts.write_case_dictionaries(".", cfg,
                                              estimate.n_equivalent_particles):
    print(f"    wrote {path}")
PY

if [ "$DICT_ONLY" -eq 1 ]; then
    echo ""
    echo "Dictionaries written. To mesh:  blockMesh && snappyHexMesh -overwrite"
    exit 0
fi

# --------------------------------------------------------------------------- #
# 2. mesh
# --------------------------------------------------------------------------- #

for cmd in blockMesh snappyHexMesh checkMesh; do
    have "$cmd" || die "'$cmd' is not on PATH. Source your OpenFOAM environment,
       or use --dict-only to write the dictionaries without meshing."
done

# Clear everything in constant/polyMesh that addresses the OLD mesh by index.
# blockMesh rewrites points/faces/owner/neighbour/boundary and nothing else, so
# stale sets/ and snappyHexMesh octree bookkeeping would survive and refer to a
# mesh that no longer exists. Every one of these is regenerated by the pipeline.
if [ -d constant/polyMesh ]; then
    echo "==> clearing stale mesh bookkeeping"
    for stale in sets cellLevel pointLevel level0Edge refinementHistory \
                 surfaceIndex cellZones faceZones pointZones; do
        [ -e "constant/polyMesh/$stale" ] && rm -rf "constant/polyMesh/$stale"
    done
fi

run blockMesh blockMesh
run snappyHexMesh snappyHexMesh -overwrite
run checkMesh checkMesh

echo ""
echo "    mesh quality (from log.checkMesh):"
grep -E "cells:|non-orthogonality|Max skewness|Max aspect ratio|Mesh OK" \
    log.checkMesh | sed 's/^/      /' || true
echo ""
echo "    patches:"
awk '/Checking patch topology/,/^$/ {if ($2 ~ /^[0-9]+$/) print "      " $0}' \
    log.checkMesh || true

# --------------------------------------------------------------------------- #
# 3. verify the mesh is the geometry case.yaml declares
# --------------------------------------------------------------------------- #

echo ""
echo "==> verifying the mesh against case.yaml"
$PYTHON -m plumetools.markelov1999.verify . \
    || die "mesh verification failed (see above). checkMesh says the mesh is
       valid; this says it is not the geometry the model would be evaluated on."

echo ""
echo "Done. Next:  ./Allrun"
