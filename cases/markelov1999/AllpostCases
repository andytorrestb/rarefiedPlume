#!/bin/bash
#
# Post-process every generated case and build the combined study table.
#
#   ./AllpostCases               post-process all of them, then render
#   ./AllpostCases --keep-going  do not stop at the first failure
#   ./AllpostCases --no-viz      study outputs only, no imagery
#   ./AllpostCases --viz-only    imagery only, skip the study outputs
#   ./AllpostCases --viz-spec F  render with sampling configuration F
#   ./AllpostCases --help
#
# Produces:
#
#   <case>/case-summary.json     per case
#   <case>/results/viz/*.png     mid-plane imagery, and manifest.yaml
#   results/study-table.csv      the combined table
#   results/*.png                windward / leeward / ratio against pressure
#
# Rows follow manifest.yaml order -- sorted by reservoir pressure -- so the table
# is byte-for-byte reproducible.
#
# The imagery is a SURVEY, not a result. It needs ParaView and VifPara; if those
# are not installed the step says so and everything else is unaffected. The cut
# is the y = 0 symmetry plane, which is where the cylinder, the plate and the
# plume axis all are -- see docs/viz-slices.md.

set -uo pipefail
SELF=${0##*/}
cd "${0%/*}" || exit 1

KEEP_GOING=0
VIZ=1
VIZ_ONLY=0
VIZ_SPEC=""
while [ $# -gt 0 ]; do
    case "$1" in
        --keep-going)  KEEP_GOING=1 ;;
        --no-viz)      VIZ=0 ;;
        --viz-only)    VIZ_ONLY=1 ;;
        --viz-spec)    shift; VIZ_SPEC=${1:?"--viz-spec needs a file"} ;;
        -h|--help)     awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; exit 0 ;;
        *)             echo "AllpostCases: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
done

die() { echo "" >&2; echo "AllpostCases: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# --------------------------------------------------------------------------- #
# mid-plane imagery
#
# One vifpara invocation for the whole study, not one per case: ParaView's
# startup and the reader's mesh scan cost more than the rendering does, and
# paying them once is the difference between a step you leave switched on and
# one you turn off.
#
# This family has WALLS -- the cylinder and the plate -- so q and fD are real
# here and are drawn on those surfaces. In cases/cai2012, which has no solid
# body, the same spec finds them identically zero and skips them.
# --------------------------------------------------------------------------- #
render_midplane() {
    local root=../.. renderer spec
    renderer=$root/plumetools/viz/render_slices.py
    spec=${VIZ_SPEC:-$root/plumetools/viz/midplane.yaml}

    echo "=============================================================="
    echo "### mid-plane imagery"

    if ! have vifpara; then
        echo "    skipped: 'vifpara' is not on PATH."
        echo "             pip install -e \".[viz]\", and install ParaView 5.11-5.13"
        echo "             separately; see docs/environment.md."
        echo "             The study outputs above are unaffected."
        return 0
    fi
    [ -f "$renderer" ] || { echo "AllpostCases: no $renderer" >&2; return 1; }
    [ -f "$spec" ]     || { echo "AllpostCases: no spec at $spec" >&2; return 1; }

    echo "    spec      $spec"
    echo ""
    # NOT 'python': paraview.simple exists only inside ParaView's interpreter,
    # and the vifpara launcher is what puts this venv in there.
    vifpara "$renderer" "${CASES[@]}" --spec "$spec"
}

[ -f manifest.yaml ] || die "no manifest.yaml. Generate the cases first:
       ./generate_cases.py"

have python && PYTHON=python || { have python3 && PYTHON=python3 || die "no python on PATH"; }

mapfile -t CASES < <($PYTHON - <<'PY'
import yaml
document = yaml.safe_load(open("manifest.yaml", encoding="utf-8"))
for entry in document.get("cases", []):
    print(entry["path"])
PY
) || die "could not read manifest.yaml"

if [ "$VIZ_ONLY" -eq 1 ]; then
    render_midplane || die "rendering failed"
    exit 0
fi

echo "### post-processing ${#CASES[@]} case(s)"
echo ""

FAILED=()
for case_path in "${CASES[@]}"; do
    echo "=============================================================="
    if [ -x "$case_path/Allpost" ]; then
        "$case_path/Allpost" || FAILED+=("$case_path")
    elif [ -f "$case_path/Allpost" ]; then
        bash "$case_path/Allpost" || FAILED+=("$case_path")
    else
        echo "AllpostCases: $case_path has no Allpost" >&2
        FAILED+=("$case_path")
    fi
    if [ ${#FAILED[@]} -gt 0 ] && [ "$KEEP_GOING" -eq 0 ]; then
        die "${FAILED[0]} failed. Use --keep-going to continue with the rest."
    fi
    echo ""
done

# --------------------------------------------------------------------------- #
# combined study table
# --------------------------------------------------------------------------- #

echo "=============================================================="
echo "### combined study table"

$PYTHON - <<'PY' || die "could not build the study table"
import json
from pathlib import Path

import yaml

from plumetools.markelov1999.postprocess import (
    STUDY_COLUMNS,
    plot_study,
    summary_row,
    write_study_table,
)

document = yaml.safe_load(open("manifest.yaml", encoding="utf-8"))
rows = []
missing = []
for entry in document.get("cases", []):
    path = Path(entry["path"]) / "case-summary.json"
    if not path.is_file():
        missing.append(entry["path"])
        continue
    summary = json.loads(path.read_text(encoding="utf-8"))
    summary.setdefault("case", {}).setdefault("name", entry["name"])
    summary["case"].setdefault("pressure_psi", entry["pressure_psi"])
    summary["case"].setdefault("pressure_pa", entry["pressure_pa"])
    summary["case"].setdefault("gap_in", entry["gap_in"])
    rows.append(summary_row(summary))

table = write_study_table(Path("results") / "study-table.csv", rows)
print(f"    wrote {table}  ({len(rows)} row(s))")
if missing:
    print(f"    {len(missing)} case(s) had no case-summary.json: {missing}")

widths = {c: max(len(c), 14) for c in STUDY_COLUMNS}
print()
print("    " + "  ".join(f"{c:>{widths[c]}}" for c in STUDY_COLUMNS))
for row in rows:
    cells = []
    for column in STUDY_COLUMNS:
        value = row.get(column, "")
        cells.append(f"{value:>{widths[column]}.6g}"
                     if isinstance(value, float) else f"{str(value):>{widths[column]}}")
    print("    " + "  ".join(cells))

figures = plot_study(table, Path("results"))
print()
if figures:
    for figure in figures:
        print(f"    wrote {figure}")
else:
    print("    no plots: matplotlib is not installed "
          '(pip install -e ".[plots]")')
PY

echo ""
VIZ_FAILED=0
if [ "$VIZ" -eq 1 ]; then
    render_midplane || VIZ_FAILED=1
    echo ""
fi

if [ ${#FAILED[@]} -gt 0 ]; then
    echo "AllpostCases: ${#FAILED[@]} case(s) failed:" >&2
    printf '    %s\n' "${FAILED[@]}" >&2
    exit 1
fi
# A failed render is reported, but only after the study outputs are already on
# disk: the images are a survey and must never cost anyone the numbers.
[ "$VIZ_FAILED" -eq 0 ] || die "the mid-plane imagery failed (see above).
       The study outputs and results/study-table.csv are complete;
       re-run just the imagery with ./AllpostCases --viz-only"
echo "### done"
echo ""
echo "These results are NOT validated. Nothing here has been compared with DAC"
echo "or with experiment; see cases/markelov1999/README.md."
