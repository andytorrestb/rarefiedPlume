#!/bin/bash
#
# Reset this case.
#
#   ./Allclean               remove solver output, converted fields and results
#   ./Allclean --dry-run     list what would be removed
#   ./Allclean --mesh        also remove the mesh and the generated dictionaries
#   ./Allclean --help
#
# NEVER touched: case.yaml, unigas.yaml, diagnostics.yaml and the scripts.
# Everything this removes is regenerated by ./Allmesh and ./Allrun.

set -uo pipefail
SELF=${0##*/}
cd "$(dirname "$0")" || exit 1

DRY=0
MESH=0
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)  DRY=1 ;;
        --mesh)     MESH=1 ;;
        -h|--help)  awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; exit 0 ;;
        *)          echo "Allclean: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
done

# Refuse to run anywhere that is not a case: this removes directories by name.
[ -f case.yaml ] && [ -f unigas.yaml ] || { echo "Allclean: no case.yaml and unigas.yaml
       here; refusing to remove anything. This is not a cai2012-unigas case." >&2; exit 1; }

remove() {
    for target in "$@"; do
        [ -e "$target" ] || continue
        if [ "$DRY" -eq 1 ]; then
            echo "    would remove $target"
        else
            rm -rf "$target"
            echo "    removed $target"
        fi
    done
}

echo "### cleaning ${PWD##*/}"
for entry in */; do
    name=${entry%/}
    case "$name" in
        0|constant|system|processor*|results|postProcessing) continue ;;
    esac
    if [ -n "$name" ] && [ -z "${name//[0-9.eE+-]/}" ]; then
        remove "$name"
    fi
done
remove 0 processor* postProcessing results case-summary.json output.log error.log
remove log.uniGasFoam log.decomposePar log.reconstructPar log.reconstructPar.resume
remove log.writeCellCentres log.writeCellVolumes
remove system/decomposeParDict.Allrun

if [ "$MESH" -eq 1 ]; then
    remove constant/polyMesh constant/uniGasProperties
    remove system/blockMeshDict system/topoSetDict system/createPatchDict system/meshQualityDict
    remove system/controlDict system/controlDict.startup system/controlDict.sampling
    remove system/boundariesDict system/fieldPropertiesDict system/uniGasInitialisationDict
    remove system/hybridDecompositionDict system/chemReactDict
    remove system/decomposeParDict system/fvSchemes system/fvSolution
    remove log.blockMesh log.topoSet log.createPatch log.checkMesh
fi

echo ""
if [ "$DRY" -eq 1 ]; then
    echo "--dry-run: nothing removed."
else
    echo "### done. Regenerate with ./Allmesh then ./Allrun."
fi
