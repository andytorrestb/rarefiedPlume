#!/bin/bash
#
# Regenerate constant/polyMesh from case.yaml.
#
#   ./Allmesh --yes           # generate, mesh, and verify
#   ./Allmesh --dict-only     # write the dictionaries and stop (no OpenFOAM needed)
#
# The pipeline follows mesh.type in case.yaml:
#
#   snappy_hex_sphere   blockMesh, snappyHexMesh   background box, then the inflow
#                                                  cavity carved and snapped to a
#                                                  searchableSphere  (THIS CASE)
#   block_mesh_ogrid    blockMesh                  5-block hexahedral O-grid, the
#                                                  hemisphere built in blockMeshDict
#
# Under snappy_hex_sphere, blockMeshDict describes ONLY the background box -- a
# plain uniform hex block with no sphere in it. The cavity, the inflow patch and
# the surface refinement all come from snappyHexMeshDict.
#
# ============================ WARNING =========================================
# This OVERWRITES constant/polyMesh.
#
# The committed mesh is the ORIGINAL Pointwise V18.5R2 export -- 99 240
# tetrahedra with 2044 triangular inflow faces. It is the only copy: the .pw
# project files under mesh/ are binary and cannot be regenerated without an
# interactive licensed Pointwise session. It is also the substrate the
# regression golden in tests/regression/golden is bound to, so overwriting it
# makes `pytest tests/regression` fail until you restore it.
#
# A generated mesh is a DIFFERENT mesh -- hexahedra or polyhedra, quadrilateral
# or polygonal inflow faces, at whatever resolution case.yaml asks for. It is an
# equivalent geometry, not the same mesh, and it cannot reproduce the golden.
#
# Run this only deliberately. ./Allrun never calls it.
#
# To restore the Pointwise mesh afterwards:
#     git checkout -- constant/polyMesh
# ==============================================================================

set -uo pipefail
SELF=${0##*/}
cd "${0%/*}" || exit 1

DICT_ONLY=0
case "${1:-}" in
    --yes)       ;;
    --dict-only) DICT_ONLY=1 ;;
    -h|--help)   awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; exit 0 ;;
    *)
        echo "This overwrites constant/polyMesh (the committed Pointwise mesh)."
        echo "Re-run as:  ./Allmesh --yes        (generate + mesh + verify)"
        echo "        or: ./Allmesh --dict-only  (write dictionaries only)"
        exit 1
        ;;
esac

die() { echo "" >&2; echo "Allmesh: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

run() {
    local log="log.$1"; shift
    echo "==> $* (-> $log)"
    if ! "$@" > "$log" 2>&1; then
        echo "" >&2; tail -25 "$log" >&2
        die "'$1' failed; full output in $PWD/$log"
    fi
}

have python && PYTHON=python || { have python3 && PYTHON=python3 || die "no python on PATH"; }
$PYTHON -c "import plumetools" 2>/dev/null \
    || die "plumetools is not importable. From the repository root: pip install -e \".[test]\""

# --------------------------------------------------------------------------- #
# 1. dictionaries
# --------------------------------------------------------------------------- #

echo "==> generating mesh dictionaries from case.yaml"
$PYTHON - <<'PY' || die "dictionary generation failed"
from plumetools.config import load_case_config
from plumetools.foamio import write_mesh_setup
cfg = load_case_config(".")
print(f"    mesh.type = {cfg.mesh.type}")
if cfg.mesh.type == "block_mesh_ogrid":
    print(f"    projection = {cfg.mesh.projection}")
    n = cfg.mesh.n_tangential
    print(f"    {5 * n * n} inflow quads, {5 * n * n * cfg.mesh.n_radial} cells")
else:
    # The two numbers that decide whether this mesh is affordable and whether it
    # resolves the source: how coarse the far field is, and how fine the sphere is.
    from math import prod
    from plumetools.foamio.snappy import background_divisions, surface_cell_size
    div = background_divisions(cfg)
    print(f"    background  {div[0]}x{div[1]}x{div[2]} = {prod(div)} cells "
          f"of {cfg.mesh.background_cell_size_m} m")
    print(f"    surface     {surface_cell_size(cfg):g} m after "
          f"{cfg.mesh.refinement_level} octree levels "
          f"({cfg.mesh.sphere_radius_m / surface_cell_size(cfg):g} cells across R)")
for p in write_mesh_setup(".", cfg):
    print(f"    wrote {p}")
PY

# The pipeline is derived from case.yaml, not hardcoded here, so the two stay in
# step when a mesh type is added.
PIPELINE=$($PYTHON -c "
from plumetools.config import load_case_config
from plumetools.foamio import mesh_pipeline
print(' '.join(mesh_pipeline(load_case_config('.'))))
") || die "could not determine the mesh pipeline"

if [ "$DICT_ONLY" -eq 1 ]; then
    echo ""
    echo "Dictionaries written. To mesh:  $PIPELINE"
    exit 0
fi

# --------------------------------------------------------------------------- #
# 2. mesh
# --------------------------------------------------------------------------- #

for cmd in $PIPELINE checkMesh; do
    have "$cmd" || die "'$cmd' is not on PATH. Source your OpenFOAM environment,
       or use --dict-only to write the dictionaries without meshing."
done

# Clear everything in constant/polyMesh that addresses the OLD mesh by index.
# blockMesh rewrites points/faces/owner/neighbour/boundary and nothing else, so
# without this:
#
#   sets/*            face labels into the previous mesh. runInflow.py PREFERS
#                     constant/polyMesh/sets/<patch> over the patch face range,
#                     and only a count mismatch is caught -- equal counts would
#                     apply the inflow model to the wrong faces.
#   cellLevel etc.    snappyHexMesh's own octree bookkeeping, left behind by a
#                     previous -overwrite run and sized for that mesh.
#   *Zones            Pointwise export leftovers, addressed by index.
#
# Removing them is safe: every one is regenerated by the pipeline or by topoSet.
echo "==> clearing stale mesh bookkeeping from constant/polyMesh"
for stale in sets cellLevel pointLevel level0Edge refinementHistory surfaceIndex \
             cellZones faceZones pointZones; do
    if [ -e "constant/polyMesh/$stale" ]; then
        rm -rf "constant/polyMesh/$stale"
        echo "    removed constant/polyMesh/$stale"
    fi
done

for cmd in $PIPELINE; do
    case "$cmd" in
        # -overwrite writes straight into constant/polyMesh rather than leaving
        # 1/, 2/, 3/ time directories behind for the next run to trip over.
        snappyHexMesh) run snappyHexMesh snappyHexMesh -overwrite ;;
        *)             run "$cmd" "$cmd" ;;
    esac
done

run checkMesh checkMesh

# The reason this case moved off the O-grid, so print it rather than burying it
# in log.checkMesh. Non-orthogonality and skewness are what the block topology
# was costing; cell counts are what the octree levels are costing.
echo ""
echo "    mesh quality (from log.checkMesh):"
grep -E "cells:|non-orthogonality|Max skewness|Max aspect ratio" log.checkMesh \
    | sed 's/^/      /' || true
echo ""
echo "    patches:"
awk '/Checking patch topology/,/^$/ {if ($2 ~ /^[0-9]+$/) print "      " $0}' \
    log.checkMesh || true

# --------------------------------------------------------------------------- #
# 3. verify the mesh is the geometry case.yaml declares
# --------------------------------------------------------------------------- #

echo "==> verifying the mesh against case.yaml"
$PYTHON -m plumetools.verify_mesh . || die "mesh verification failed (see above)"

echo ""
echo "Done. The inflow patch now has a different face count, so everything keyed"
echo "to it is stale. ./Allrun redoes both, in this order:"
echo ""
echo "    topoSet          -> constant/polyMesh/sets/inflow  (deleted above)"
echo "    runInflow.py     -> 0/boundaryU, boundaryT, boundaryNumberDensity_*"
echo ""
echo "The regression golden will NOT match -- it is bound to the Pointwise mesh."
echo "Restore it with:  git checkout -- constant/polyMesh"
