FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      dsmcInitialiseDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Targets OpenFOAM's own dsmcInitialise (checked against v2512), which takes a
// flat dictionary. The micro/nano-flow fork used a `configurations ( { type
// dsmcMeshFill; ... } )` list instead; that version is kept alongside as
// dsmcInitialiseDict.mnf. See docs/solver-compatibility.md.

// The domain starts empty: this is a plume expanding into vacuum, and every
// particle should enter through the inflow patch. A zero number density means
// dsmcInitialise seeds no particles, matching the fork's `Ar 0`.
//
// temperature must still be non-zero -- FreeStream.C rejects a zero boundary
// temperature, and dsmcInitialise uses this value to set the initial field.

numberDensities
{
    Ar          0;
};

temperature     300;

velocity        (0 0 0);

// ************************************************************************* //
