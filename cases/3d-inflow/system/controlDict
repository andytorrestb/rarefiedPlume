FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// OpenFOAM's own solver, not the MNF fork's dsmcFoam+.
// Allrun reads this entry, so switching solvers is a one-line change here.
application     dsmcFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1.0E-01;

deltaT          1.0E-05;

writeControl    adjustableRunTime;

writeInterval   2.5E-04;

//purgeWrite      10;

writeFormat     ascii;

writePrecision  15;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       1;


// ************************************************************************* //
