#!/bin/bash
#
# Run every generated case, in order.
#
#   ./AllrunCases                run all of them
#   ./AllrunCases --serial       one process per case
#   ./AllrunCases -np 8          override the subdomain count
#   ./AllrunCases --no-solve     generate 0/ only (needs no solver)
#   ./AllrunCases --keep-going   do not stop at the first failure
#   ./AllrunCases --help
#
# SELECTING CASES -- for a job array
#
#   ./AllrunCases --list              the case list, numbered, one per line
#   ./AllrunCases --index 0           only case 0 (0-based, as --list prints it)
#   ./AllrunCases --case Kn100_np2x   only this case, by name or by path
#
# --index is what an array task uses. With 12 cases:
#
#   #SBATCH --array=0-11
#   ./AllrunCases --index "$SLURM_ARRAY_TASK_ID"
#
# The order is manifest.yaml's, which generate_cases.py fixed: decreasing
# Knudsen number, and within each case increasing particle multiplier. It does
# not depend on directory iteration order, so index N means the same case on
# every node and in every rerun.
#
# Sequentially, not in parallel: each case already uses every core it is given,
# and two DSMC runs competing for memory is how a study of three cases turns
# into three cases that all get killed.
#
# Cases come from manifest.yaml in the order generate_cases.py wrote them --
# most rarefied first, which is also the order the results should be trusted in:
# Kn = 100 is the collisionless benchmark, and if it does not reproduce the
# analytical solution the collisional cases mean nothing.
#
# Nothing here re-meshes. ./Allrun never does, and a solver run that changed its
# own geometry would invalidate its own results.
#
# Re-running this CONTINUES each case from its newest time directory rather than
# restarting it -- see ./Allrun --help. A study interrupted part-way is finished
# by running this again; cases that already reached endTime report that and are
# skipped in seconds.

set -uo pipefail
SELF=${0##*/}
cd "$(dirname "$0")" || exit 1   # dirname, not ${0%/*}: works for "./x" and for "bash x"

ARGS=()
SELECT=()
LIST=0
KEEP_GOING=0
while [ $# -gt 0 ]; do
    case "$1" in
        --keep-going)  KEEP_GOING=1 ;;
        -s|--serial)   ARGS+=("--serial") ;;
        -np)           shift; ARGS+=("-np" "${1:?"-np needs a subdomain count"}") ;;
        --no-solve)    ARGS+=("--no-solve") ;;
        --list)        LIST=1 ;;
        --index)       shift; SELECT+=("${1:?"--index needs a case number"}") ;;
        --case)        shift; SELECT+=("${1:?"--case needs a case name"}") ;;
        -h|--help)     awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; exit 0 ;;
        *)             echo "AllrunCases: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
done

die() { echo "" >&2; echo "AllrunCases: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

[ -f manifest.yaml ] || die "no manifest.yaml. Generate the cases first:
       ./generate_cases.py"

have python && PYTHON=python || { have python3 && PYTHON=python3 || die "no python on PATH"; }

mapfile -t CASES < <($PYTHON - <<'PY'
import yaml
document = yaml.safe_load(open("manifest.yaml", encoding="utf-8"))
for entry in document.get("cases", []):
    print(entry["path"])
PY
) || die "could not read manifest.yaml"

[ ${#CASES[@]} -gt 0 ] || die "manifest.yaml lists no cases"

# --------------------------------------------------------------------------- #
# case selection
# --------------------------------------------------------------------------- #
#
# The manifest order is the contract -- see --help. Selecting by index rather
# than by globbing is what lets a job array address one case per task without
# every task having to agree about how a shell sorts names.

if [ "$LIST" -eq 1 ]; then
    for i in "${!CASES[@]}"; do
        printf '%d\t%s\n' "$i" "${CASES[$i]}"
    done
    exit 0
fi

if [ ${#SELECT[@]} -gt 0 ]; then
    PICKED=()
    for want in "${SELECT[@]}"; do
        FOUND=""
        case "$want" in
            ''|*[!0-9]*)
                # A name or a path.
                for case_path in "${CASES[@]}"; do
                    if [ "$case_path" = "$want" ] || [ "${case_path##*/}" = "$want" ]; then
                        FOUND=$case_path
                        break
                    fi
                done
                [ -n "$FOUND" ] || die "no case '$want' in manifest.yaml.
       Use --list to see the ${#CASES[@]} case(s) it holds." ;;
            *)
                # An index, 0-based.
                [ "$want" -lt ${#CASES[@]} ] || die "--index $want is past the
       end: manifest.yaml holds ${#CASES[@]} case(s), so the valid range is
       0-$(( ${#CASES[@]} - 1 )). Use --list to see them."
                FOUND=${CASES[$want]} ;;
        esac
        PICKED+=("$FOUND")
    done
    CASES=("${PICKED[@]}")
fi

echo "### running ${#CASES[@]} case(s), sequentially"
echo ""

START=$(date +%s)
FAILED=()
for case_path in "${CASES[@]}"; do
    echo "=============================================================="
    echo "### $case_path"
    echo "=============================================================="
    [ -d "$case_path/constant/polyMesh" ] || die "$case_path has no mesh.
       Run ./AllmeshCases first."

    CASE_START=$(date +%s)
    if [ -x "$case_path/Allrun" ]; then
        "$case_path/Allrun" "${ARGS[@]+"${ARGS[@]}"}" || FAILED+=("$case_path")
    elif [ -f "$case_path/Allrun" ]; then
        bash "$case_path/Allrun" "${ARGS[@]+"${ARGS[@]}"}" || FAILED+=("$case_path")
    else
        echo "AllrunCases: $case_path has no Allrun" >&2
        FAILED+=("$case_path")
    fi
    echo "    elapsed $(( $(date +%s) - CASE_START )) s"

    if [ ${#FAILED[@]} -gt 0 ] && [ "$KEEP_GOING" -eq 0 ]; then
        die "${FAILED[0]} failed. Its log files are in that directory.
       Use --keep-going to run the remaining cases anyway."
    fi
    echo ""
done

echo "### finished in $(( $(date +%s) - START )) s"
if [ ${#FAILED[@]} -gt 0 ]; then
    echo "" >&2
    echo "AllrunCases: ${#FAILED[@]} of ${#CASES[@]} case(s) failed:" >&2
    printf '    %s\n' "${FAILED[@]}" >&2
    exit 1
fi
echo "    next:  ./AllpostCases"
