#!/bin/bash
#
# Reset this case.
#
#   ./Allclean               remove solver output and generated 0/
#   ./Allclean --dry-run     list what would be removed
#   ./Allclean --mesh        also remove the mesh and the generated dictionaries
#   ./Allclean --help
#
# NEVER touched:
#   case.yaml            the authoritative source of physical inputs
#   Allmesh, Allrun, Allpost, Allclean, runInflow.py, postProcess.py
#
# Everything this removes is regenerated by ./Allmesh and ./Allrun, so a clean
# case and a fresh clone behave identically.

set -uo pipefail
SELF=${0##*/}
cd "$(dirname "$0")" || exit 1   # dirname, not ${0%/*}: works for "./x" and for "bash x"

DRY=0
MESH=0
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)  DRY=1 ;;
        --mesh)     MESH=1 ;;
        -h|--help)  awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"; exit 0 ;;
        *)          echo "Allclean: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
done

# Refuse to run anywhere that is not a case. This script removes directories by
# name, and running it in the wrong place is the one way it could do harm.
[ -f case.yaml ] || { echo "Allclean: no case.yaml here; refusing to remove
       anything. This is not a cai2012 case directory." >&2; exit 1; }

remove() {
    for target in "$@"; do
        [ -e "$target" ] || continue
        if [ "$DRY" -eq 1 ]; then
            echo "    would remove $target"
        else
            rm -rf "$target"
            echo "    removed $target"
        fi
    done
}

echo "### cleaning ${PWD##*/}"

# Time directories other than 0, which only the solver creates.
for entry in */; do
    name=${entry%/}
    case "$name" in
        0|constant|system|results) continue ;;
    esac
    if [ "$name" = "${name%%[!0-9.eE+-]*}" ] && [ -n "$name" ]; then
        case "$name" in
            *[0-9]*) remove "$name" ;;
        esac
    fi
done

remove 0 processor* postProcessing results case-summary.json
remove log.dsmcFoam log.dsmcInitialise log.decomposePar log.reconstructPar
remove log.writeCellCentres log.writeCellVolumes
remove system/decomposeParDict.Allrun

if [ "$MESH" -eq 1 ]; then
    remove constant/polyMesh constant/dsmcProperties
    remove system/blockMeshDict system/topoSetDict system/createPatchDict
    remove system/meshQualityDict system/controlDict system/dsmcInitialiseDict
    remove system/decomposeParDict system/fvSchemes system/fvSolution
    remove log.blockMesh log.topoSet log.createPatch log.checkMesh
fi

echo ""
if [ "$DRY" -eq 1 ]; then
    echo "--dry-run: nothing removed."
else
    echo "### done. Regenerate with ./Allmesh then ./Allrun."
fi
